# Copy to .env.local and fill in. Never commit real secrets.

# --- App ---------------------------------------------------------------------
# Public URL of the app (used in Stripe redirects and auth emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Auth + Postgres + Storage) -------------------------------------
# Local: values printed by `npx supabase start` / `npx supabase status`.
# Cloud: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56521
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used for credits, analyses, webhooks and account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider ----------------------------------------------------------------
# "heuristic" = deterministic rule-based engine (no API key, no cost, works offline).
# "anthropic" = Claude via the Anthropic API (better parsing and wording; same fact guards).
# Leave empty: Claude is used automatically when ANTHROPIC_API_KEY is set. "heuristic" forces the free rule-based engine.
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Max characters of CV/job text sent to the model per request.
AI_MAX_INPUT_CHARS=40000
# AI operations allowed per user per minute (server-enforced).
AI_RATE_LIMIT_PER_MINUTE=10

# --- Uploads & privacy ------------------------------------------------------------
# Max upload size in bytes (default 5 MB).
UPLOAD_MAX_BYTES=5242880
# Keep original PDF/DOCX files in Supabase Storage? Default false: files are parsed in memory and discarded.
STORE_ORIGINAL_FILES=false
# When originals are stored, the cleanup cron deletes them after this many days.
DOCUMENT_RETENTION_DAYS=30
# OCR for scanned PDFs: "none" or "http" (POSTs the file to OCR_HTTP_URL, expects {"text": "..."}).
OCR_PROVIDER=none
OCR_HTTP_URL=
OCR_HTTP_TOKEN=

# --- Stripe (use TEST keys until you go live) ---------------------------------------
STRIPE_SECRET_KEY=sk_test_
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or the Dashboard endpoint.
STRIPE_WEBHOOK_SECRET=whsec_

# --- Cron -----------------------------------------------------------------------
# Protects GET /api/cron/cleanup (send header: Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=
