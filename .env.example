# Copy to .env.local and fill in. Never commit real secrets.

# --- App ---------------------------------------------------------------------
# Public URL of the app (used in Stripe redirects and auth emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Auth + Postgres + Storage) -------------------------------------
# Local: values printed by `npx supabase start` / `npx supabase status`.
# Cloud: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56521
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used for credits, analyses, webhooks and account deletion.
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile site key (public). Optional: empty = no captcha widget on signup, login and forgot password.
# When set, the forms send the token to Supabase. Order matters: deploy with this key FIRST, then enable
# Supabase -> Authentication -> Attack Protection -> CAPTCHA (Turnstile + the secret key). Enabling it in Supabase
# without this key makes every login/signup fail.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- AI provider ----------------------------------------------------------------
# "heuristic" = deterministic rule-based engine (no API key, no cost, works offline).
# "anthropic" = Claude via the Anthropic API (better parsing and wording; same fact guards).
# Leave empty: Claude is used automatically when ANTHROPIC_API_KEY is set. "heuristic" forces the free rule-based engine.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# CV/job parsing (verbatim extraction) uses a cheap model; suggestions, cover letter and
# interview prep use a stronger one. ~R$ 0,60 (US$0.11) per full analysis (see docs/PAYMENTS.md).
AI_MODEL_EXTRACT=claude-haiku-5-5
AI_MODEL_WRITE=claude-sonnet-5-5
# Max characters of CV/job text sent to the model per request.
AI_MAX_INPUT_CHARS=40000
# AI operations allowed per user per minute (server-enforced).
AI_RATE_LIMIT_PER_MINUTE=10
# Cost caps: AI calls per user per day, and cover letter / interview prep generations per analysis.
AI_DAILY_LIMIT=40
AI_EXTRAS_PER_ANALYSIS=2

# --- Uploads & privacy ------------------------------------------------------------
# Max upload size in bytes (default 4 MB; Vercel rejects request bodies over 4.5 MB).
UPLOAD_MAX_BYTES=4000000
# Keep original PDF/DOCX files in Supabase Storage? Default false: files are parsed in memory and discarded.
STORE_ORIGINAL_FILES=false
# When originals are stored, the cleanup cron deletes them after this many days.
DOCUMENT_RETENTION_DAYS=30
# OCR for scanned PDFs: "none" or "http" (POSTs the file to OCR_HTTP_URL, expects {"text": "..."}).
OCR_PROVIDER=none
OCR_HTTP_URL=
OCR_HTTP_TOKEN=

# --- Stripe (use TEST keys until you go live) ---------------------------------------
STRIPE_SECRET_KEY=sk_test_
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or the Dashboard endpoint.
STRIPE_WEBHOOK_SECRET=whsec_
# Stripe Tax does not support Brazil: keep false.
STRIPE_AUTOMATIC_TAX=false

# --- Cron -----------------------------------------------------------------------
# Protects GET /api/cron/cleanup (send header: Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# --- Legal (shown on /legal and /privacy; required in production) -----------------
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_TAX_ID=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
# Days until deleted data also disappears from database backups (Supabase Pro: 7).
LEGAL_BACKUP_RETENTION_DAYS=7

# NexForge management panel (internal product metrics, optional). All three unset = nothing is sent.
# Only minimal events with a pseudonymous user id — never CV text, job ads, names or e-mails.
NEXFORGE_ENDPOINT=
NEXFORGE_INGEST_KEY=
# Random and unique to this product (openssl rand -base64 32). Never share it.
NEXFORGE_PSEUDONYM_SECRET=
